                    "anyOf": [
                        {
                            "type": "string",
                            "enum": [
                                "USER_FINISHED",
                                "PLAN_COMPLETED",
                                "BUDGET_REACHED"
                            ]
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "endSequence": {
                    "type": "integer"
                },
                "automaticOperationId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "id",
                "date",
                "zoneId",
                "opensAtMs",
                "closesAtMs"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.contract.LearningPlan": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "dayId": {
                    "type": "string"
                },
                "policyVersion": {
                    "type": "integer"
                },
                "targetIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "newCount": {
                    "type": "integer"
                },
                "reviewCount": {
                    "type": "integer"
                },
                "deferredCount": {
                    "type": "integer"
                },
                "estimatedMs": {
                    "type": "integer"
                },
                "estimateSource": {
                    "type": "string"
                },
                "budgetMs": {
                    "type": "integer"
                },
                "createdAtMs": {
                    "type": "integer"
                },
                "newWordCount": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ]
