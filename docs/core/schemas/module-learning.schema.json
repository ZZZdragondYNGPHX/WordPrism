                "plannerVersion": {
                    "type": "integer"
                },
                "deferredReviewCount": {
                    "type": "integer"
                },
                "deferredNewWordCount": {
                    "type": "integer"
                },
                "unavailableTargetCount": {
                    "type": "integer"
