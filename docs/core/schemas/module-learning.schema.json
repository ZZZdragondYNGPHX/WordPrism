                "targetIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "completedTargets": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "currentActivityId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "currentPresentationId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "timerMode": {
                    "type": "string",
                    "enum": [
                        "STUDY",
                        "WAITING",
                        "BACKGROUND",
                        "PAUSED"
                    ]
                },
                "timerAtMs": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "studyMs": {
                    "type": "integer"
                },
                "waitingMs": {
                    "type": "integer"
                },
                "backgroundMs": {
                    "type": "integer"
                },
                "extraBudgetDayId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "lastAnswerId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "awaitingAdvance": {
                    "type": "boolean"
                },
                "revisingAnswerId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "includeIntroductions": {
                    "type": "boolean"
                },
                "exposedSenseIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "lastPresentationId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "reinforcementTargets": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "completedReinforcements": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "id",
                "dayId",
                "planId",
                "policyVersion",
                "targetIds"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.engine.TimeSpan": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "sessionId": {
                    "type": "string"
                },
                "dayId": {
                    "type": "string"
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "STUDY",
                        "WAITING",
                        "BACKGROUND",
                        "PAUSED"
                    ]
                },
                "fromMs": {
                    "type": "integer"
                },
                "toMs": {
                    "type": "integer"
                },
                "targetId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "id",
                "sessionId",
                "dayId",
                "mode",
                "fromMs",
                "toMs"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.contract.LearningDay": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "date": {
                    "type": "string"
                },
                "zoneId": {
                    "type": "string"
                },
                "opensAtMs": {
                    "type": "integer"
                },
                "closesAtMs": {
                    "type": "integer"
                },
                "planId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "endedAtMs": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ]
