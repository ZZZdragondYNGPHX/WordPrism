{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "WordPrism learning module v2",
    "allOf": [
        {
            "$ref": "#/$defs/dev.wordprism.engine.Database"
        }
    ],
    "$defs": {
        "dev.wordprism.engine.Database": {
            "type": "object",
            "properties": {
                "sequence": {
                    "type": "integer"
                },
                "answers": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.Answer"
                    }
                },
                "answerVersions": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.Answer"
                    }
                },
                "presentations": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "exposures": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.Exposure"
                    }
                },
                "feedback": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.Feedback"
                    }
                },
                "difficultyMarks": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.DifficultyMark"
                    }
                },
                "sessions": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.Session"
                    }
                },
                "timeSpans": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.engine.TimeSpan"
                    }
                },
                "days": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.LearningDay"
                    }
                },
                "plans": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/dev.wordprism.contract.LearningPlan"
                    }
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "dev.wordprism.contract.Answer": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "sequence": {
                    "type": "integer"
                },
                "sessionId": {
                    "type": "string"
                },
                "activityId": {
                    "type": "string"
                },
                "activityVersion": {
                    "type": "integer"
                },
                "targetId": {
                    "type": "string"
                },
                "version": {
                    "type": "integer"
                },
                "input": {
                    "$ref": "#/$defs/dev.wordprism.contract.AnswerInput"
                },
                "atMs": {
                    "type": "integer"
                },
                "verdict": {
                    "type": "string",
                    "enum": [
                        "CORRECT",
                        "INCORRECT",
                        "UNGRADED",
                        "DISPUTED",
                        "SKIPPED"
                    ]
                },
                "gradeSource": {
                    "type": "string",
                    "enum": [
                        "OBJECTIVE",
                        "USER",
                        "AI",
                        "UNGRADED"
                    ]
                },
                "rating": {
                    "anyOf": [
                        {
                            "type": "string",
                            "enum": [
                                "AGAIN",
                                "HARD",
                                "GOOD",
                                "EASY"
                            ]
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "affectsSchedule": {
                    "type": "boolean"
                },
                "policyVersion": {
                    "type": "integer"
                },
                "delayed": {
                    "type": "boolean"
                },
                "newContext": {
                    "type": "boolean"
                },
                "confusedWith": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "valid": {
                    "type": "boolean"
                },
                "dayId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "id",
                "sequence",
                "sessionId",
                "activityId",
                "activityVersion",
                "targetId",
                "input",
                "atMs",
                "verdict",
                "gradeSource",
                "affectsSchedule",
                "policyVersion",
                "delayed",
                "newContext"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.contract.AnswerInput": {
            "type": "object",
            "properties": {
                "text": {
                    "type": "string"
                },
                "hintUsed": {
                    "type": "boolean"
                },
                "answerRevealed": {
                    "type": "boolean"
                },
                "difficult": {
                    "type": "boolean"
                },
                "skipped": {
                    "type": "boolean"
                },
                "selectedChoiceId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "familiar": {
                    "anyOf": [
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "requestFeedback": {
                    "type": "boolean"
                }
            },
            "required": [
                "text"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.contract.Exposure": {
            "type": "object",
            "properties": {
                "hintUsed": {
                    "type": "boolean"
                },
                "answerRevealed": {
                    "type": "boolean"
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "dev.wordprism.contract.Feedback": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "answerId": {
                    "type": "string"
                },
                "answerVersion": {
                    "type": "integer"
                },
                "explanation": {
                    "type": "string"
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "OBJECTIVE",
                        "USER",
                        "AI",
                        "UNGRADED"
                    ]
                },
                "targetUsage": {
                    "type": "string"
                },
                "quotedAnswer": {
                    "type": "string"
                },
                "provenance": {
                    "$ref": "#/$defs/dev.wordprism.contract.Provenance"
                },
                "dimensions": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/dev.wordprism.contract.WritingFeedbackDimension"
                    }
                },
                "optimizedSentence": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "optimizationNotes": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "confusionNote": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "id",
                "answerId",
                "answerVersion",
                "explanation",
                "source"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.contract.Provenance": {
            "type": "object",
            "properties": {
                "kind": {
                    "type": "string"
                },
                "operationId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "presetId": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "presetVersion": {
                    "anyOf": [
                        {
                            "type": "integer"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "model": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "atMs": {
                    "type": "integer"
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "dev.wordprism.contract.WritingFeedbackDimension": {
            "type": "object",
            "properties": {
                "dimension": {
                    "type": "string"
                },
                "comment": {
                    "type": "string"
                },
                "quote": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "dimension",
                "comment"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.contract.DifficultyMark": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "answerId": {
                    "type": "string"
                },
                "answerVersion": {
                    "type": "integer"
                },
                "difficult": {
                    "type": "boolean"
                },
                "atMs": {
                    "type": "integer"
                },
                "revision": {
                    "type": "integer"
                }
            },
            "required": [
                "id",
                "answerId",
                "answerVersion",
                "difficult",
                "atMs",
                "revision"
            ],
            "additionalProperties": false
        },
        "dev.wordprism.contract.Session": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "dayId": {
                    "type": "string"
